# Copy to apps/web/.env.local. Real values live only in Vercel / GitHub secrets / .env.local.
# Local Supabase values come from `supabase start` output.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL_DIRECT=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Auth — the only email allowed to sign in
ALLOWED_EMAIL=

# Google Drive inbox (docs/ops/sync.md)
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_INBOX_FOLDER_ID=105BHu-A_DxDA1W6otpt_gYBsbt3TN8DB
DRIVE_PROCESSED_FOLDER_ID=1wxxAa-bP08g6TDBmPHCRPn4JM9qR1orc

# Cron routes (Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

# Candles: Dukascopy Requester Pays S3 bucket (read-only IAM key; AWS bills the downloads)
DUKASCOPY_S3_ACCESS_KEY_ID=
DUKASCOPY_S3_SECRET_ACCESS_KEY=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

