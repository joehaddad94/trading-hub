{
  "name": "trading-app",
  "private": true,
  "description": "Personal trading tracker, news calendar and replay backtester",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "test:e2e": "turbo run test:e2e",
    "boundaries": "depcruise apps packages --config packages/config/dependency-cruiser.cjs",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:reprocess": "tsx scripts/reprocess-imports.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@trading/db": "workspace:*",
    "@trading/importer": "workspace:*",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.5.0",
    "drizzle-kit": "^0.31.11",
    "supabase": "2.120.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
