{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalPassThroughEnv": [
    "CI",
    "CRON_SECRET",
    "DATABASE_URL",
    "DATABASE_URL_DIRECT",
    "DRIVE_INBOX_FOLDER_ID",
    "DRIVE_PROCESSED_FOLDER_ID",
    "GOOGLE_SERVICE_ACCOUNT_JSON",
    "SKIP_ENV_VALIDATION",
    "SUPABASE_SERVICE_ROLE_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*", "SENTRY_*", "ALLOWED_EMAIL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["NEXT_PUBLIC_*", "ALLOWED_EMAIL", "SUPABASE_SERVICE_ROLE_KEY", "PLAYWRIGHT_*"]
    }
  }
}
